div#loginUser(style="display: none;")
  li.nav-item.dropdown
    a.nav-link.dropdown-toggle(id="navbarLogin",data-toggle="dropdown",aria-haspopup="true",aria-expanded="false")
      // If we're masquerading as someone
      if learner
        | <i class="fa fa-user-secret"></i> 
        span.hidden-md-down#userMasqueradingName &ldquo;#{learner.name.split(" ")[0]}&rdquo;
      else
        | <i class="fa fa-user"></i> 
        span.hidden-md-down#userFirstName Me
    div.dropdown-menu.dropdown-menu-right(aria-labelledby="navbarLogin")
      if learner
        a.dropdown-item(href=url.replace('users/' + learner._id + '/', '')) <i class='fa fa-user'></i> Stop Pretending
        div.dropdown-divider        
      a.dropdown-item(href=toValidPath(`/users/me`)) <i class='fa fa-cogs'></i> Profile
      a.dropdown-item#progress-audit-redeem-link(href=toValidPath('/progress-audit/redeem'),style="display: none;") <i class='fa fa-search'></i> Redeem progress audit token
      if activity
        a.dropdown-item#instructor-view-statistics(href="#", data-activity-url=repositoryName + '/' + activity.path, data-activity-hash=activity.hash, style="display: none;") <i class='fa fa-bar-chart'></i> View page statistics
      a.dropdown-item#progress-audit-token-link(href="#",style="display: none;") <i class='fa fa-key'></i> Generate progress audit token
      a.dropdown-item(href=toValidPath("/logout")) <i class='fa fa-sign-out'></i> Logout
div#loginGuest(style="display: none;")
  li.nav-item.dropdown
    a.nav-link.dropdown-toggle(id="navbarLogin",data-toggle="dropdown",aria-haspopup="true",aria-expanded="false")
      | <i class="fa fa-sign-in"></i>
      span.hidden-md-down &nbsp;Sign In
    div.dropdown-menu.dropdown-menu-right(aria-labelledby="navbarLogin")
      if config.googleAuth
        a.dropdown-item(href=toValidPath("/auth/google")) <i class='fa fa-google'></i> Sign In with Google
      if config.twitterAuth
        a.dropdown-item(href=toValidPath("/auth/twitter")) <i class='fa fa-twitter'></i> Sign In with Twitter
      if config.githubAuth
        a.dropdown-item(href=toValidPath("/auth/github")) <i class='fa fa-github'></i> Sign In with GitHub
      if config.localAuth
        div.dropdown-divider
        form#form-login(action=toValidPath("/auth/local"),method="post")
          div.input-group
            input.form-control#username(name="username",type="text",placeholder="Username")               
          div.input-group                     
            input.form-control#password(name="password",type="password")
          button.btn.btn-primary.btn-default#button-login(type="submit") Sign In
