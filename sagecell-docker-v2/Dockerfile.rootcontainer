# syntax=docker/dockerfile:1

ARG SAGEMATH_IMAGE=docker.io/sagemath/sagemath:10.9
FROM ${SAGEMATH_IMAGE}

USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG SAGECELL_GIT_REF=master

ENV DEBIAN_FRONTEND=noninteractive \
    SAGECELL_HOME=/opt/sagecell \
    SAGECELL_PORT=8888 \
    SAGECELL_GIT_REF=${SAGECELL_GIT_REF} \
    SAGECELL_WORKDIR=/tmp/sagecell \
    SAGECELL_DB=/var/lib/sagecell/sqlite.db \
    SAGECELL_MAX_KERNELS=4 \
    SAGECELL_MAX_PREFORKED=1 \
    SAGECELL_RLIMIT_CPU=30 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        make \
        procps \
        tini \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p "$SAGECELL_WORKDIR" /var/lib/sagecell

WORKDIR /opt

RUN git clone --depth=1 --branch "${SAGECELL_GIT_REF}" https://github.com/sagemath/sagecell.git "${SAGECELL_HOME}"

WORKDIR ${SAGECELL_HOME}

RUN sage -pip install --no-cache-dir \
        lockfile \
        paramiko \
        psutil \
        sockjs-tornado \
        sqlalchemy

COPY patch_web_server_local_provider.py /tmp/patch_web_server_local_provider.py
RUN python3 /tmp/patch_web_server_local_provider.py

COPY sagecell_config.py /opt/sagecell/config.py
COPY sagecell_log.py /opt/sagecell/log.py

# Service-only build:
# We intentionally do NOT run "sage -sh -c make" here, because that full
# static/frontend build is the fragile JSmol/Jupyter/webpack/browser UI part.
# Xronos only needs the /service execution endpoint for now.
RUN mkdir -p static build

COPY docker-entrypoint-root.sh /usr/local/bin/docker-entrypoint-root.sh
COPY healthcheck.sh /usr/local/bin/healthcheck.sh

RUN chmod +x /usr/local/bin/docker-entrypoint-root.sh /usr/local/bin/healthcheck.sh

EXPOSE 8888
VOLUME ["/var/lib/sagecell"]

HEALTHCHECK --interval=30s --timeout=45s --start-period=240s --retries=5 \
    CMD /usr/local/bin/healthcheck.sh

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/docker-entrypoint-root.sh"]
CMD ["sagecell"]
