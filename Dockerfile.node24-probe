FROM docker.io/library/node:24-bookworm

WORKDIR /usr/var/server

# This image is intentionally a dependency-compatibility probe, not a runtime
# replacement yet. Install only conventional native-addon build prerequisites;
# any additional requirements revealed by npm are useful audit findings.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      cmake \
      git \
      pkg-config \
      python3 \
 && rm -rf /var/lib/apt/lists/*

# Copy dependency manifests first so ordinary source-code changes do not
# invalidate the expensive dependency-install layer.
COPY package.json package-lock.json ./

# Install exactly the dependency graph recorded in package-lock.json. Using
# npm ci avoids re-resolving dependency versions and fails if the manifest and
# lockfile drift out of sync.
RUN echo "Node: $(node --version)" \
 && echo "npm:  $(npm --version)" \
 && npm ci --no-audit --no-fund

# Copy application source only after dependencies have been installed. The
# repository .dockerignore excludes runtime data such as repositories/,
# node_modules/, and local secrets so this remains a small build context.
COPY . .

# Do not start Xronos from this probe image. A successful build only proves the
# selected dependency graph can be installed under Node 24; later checkpoints
# will run tests and the application against the external services.
CMD ["node", "--version"]
