extends layouts/main

block content
    - var LaTeX = '<span class="other-latex">L<sup>a</sup>T<sub>e</sub>X</span>';
    - var TeX = '<span class="tex">T<sub>e</sub>X</span>';
    #myCarousel.carousel.slide(data-ride='carousel')
      img.carousel-logo(src=toValidPath(versionPath("/public/images/logo/logo.svg")))
      ol.carousel-indicators
        li.active(data-target='#myCarousel', data-slide-to='0')
        li(data-target='#myCarousel', data-slide-to='1')
        li(data-target='#myCarousel', data-slide-to='2')
      .carousel-inner(role='listbox')
        .carousel-item.active
          // I have animations
          //img.first-slide(src='data:image/gif;base64,R0lGODlhAQABAIAAAHd3dwAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==', alt='First slide') 
          .container
            .carousel-caption.d-none.d-md-block.text-left
              h1 Open Courses.  Free Math.
              p You can master mathematics with free interactive mathematics textbooks.
              p
                a.btn.btn-lg.btn-primary(href=toValidPath("/course/mooculus/calculus1"), role='button') 
                  i.fa.fa-book
                  | &nbsp;Experience Calculus One
      a.carousel-control-prev(href='#myCarousel', role='button', data-slide='prev')
        span.carousel-control-prev-icon(aria-hidden='true')
        span.sr-only Previous
      a.carousel-control-next(href='#myCarousel', role='button', data-slide='next')
        span.carousel-control-next-icon(aria-hidden='true')
        span.sr-only Next

    p.lead
    h3.center Go directly to the <a href=#{toValidPath("/repositories")}>content</a> published on this Ximera server.
    p.lead

    .container.marketing
      // Three columns of text below the carousel
      .row
        .col-lg-4
          //img.rounded-circle(src='data:image/gif;base64,R0lGODlhAQABAIAAAHd3dwAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==', alt='Generic placeholder image', width='140', height='140')
          i.fa.fa-book.fa-5x.text-muted
          h2 Educators
          p Ximera lets you write documents in !{LaTeX} and post them as interactive activities online for your students.
          p By relying on GitHub to store content, you can easily share activities with your colleagues.          
          p
            a.btn.btn-secondary(href="https://github.com/mooculus/calculus", role='button') View GitHub »
        // /.col-lg-4
        .col-lg-4
          //img.rounded-circle(src='data:image/gif;base64,R0lGODlhAQABAIAAAHd3dwAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==', alt='Generic placeholder image', width='140', height='140')
          i.fa.fa-pencil.fa-5x.text-muted          
          h2 Students
          p Ximera brings the classroom to you, wherever you are.
          p You can use your favorite device to study math anywhere, anytime.
          p
            a.btn.btn-secondary(href='/mooculus', role='button') View Textbooks »
        // /.col-lg-4
        .col-lg-4
          //img.rounded-circle(src='data:image/gif;base64,R0lGODlhAQABAIAAAHd3dwAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==', alt='Generic placeholder image', width='140', height='140')
          i.fa.fa-flask.fa-5x.text-muted                    
          h2 Researchers
          p Ximera computes statistics on student success, such as point biserials.
          p By creating branches in GitHub, you can quickly run A/B tests on student performance.
          p
            a.btn.btn-secondary(href='/about/faq', role='button') Learn More »
            
      // START THE FEATURETTES
      hr.featurette-divider
      .row.featurette
        .col-md-7
          h2.featurette-heading
            | Write once.  Share everywhere. 
            span.text-muted One source file for both PDF and HTML.
          p.lead
            | Write in !{LaTeX} using the <a href="https://github.com/XimeraProject/ximeraLatex">Ximera document class</a>.  You can print your document for your own students, or share your document with the world as an online interactive activity.  Authoring in !{LaTeX} combines the power of professional typesetting with modern web technology, all the while retaining the stability of a tried and true language.
        .col-md-5
          img.featurette-image.img-fluid.mx-auto(src=toValidPath(versionPath('/public/images/photos/tablet-and-book.jpg')))
      hr.featurette-divider
      .row.featurette
        .col-md-7.push-md-5
          h2.featurette-heading
            | Find Calculus content on
          p.lead
            | <a href="https://ximera.osu.edu//mooculus/calculus1">Calculus 1</a>, <a href="https://ximera.osu.edu/mooculus/calculus2">Calculus 2</a>, and <a href="https://ximera.osu.edu/mooculus/calculus3">Calculus 3</a>.
        .col-md-5.pull-md-7
          img.featurette-image.img-fluid.mx-auto(src=toValidPath(versionPath('/public/images/photos/calculus-textbooks.jpg')))


