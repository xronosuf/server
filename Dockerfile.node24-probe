FROM docker.io/library/node:24-bookworm

WORKDIR /usr/var/server

# This image is intentionally a dependency-compatibility probe, not a runtime
# replacement yet. Install only conventional native-addon build prerequisites;
# any additional requirements revealed by npm are useful audit findings.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      cmake \
      git \
      pkg-config \
      python3 \
 && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./

# Set OMIT_NODEGIT=1 only for diagnostic builds that want to discover the next
# Node 24 blocker after the already-confirmed nodegit@0.26.5 failure. This edits
# only the image-local package.json copy; it never changes the repository file.
ARG OMIT_NODEGIT=0
RUN if [ "$OMIT_NODEGIT" = "1" ]; then \
      node -e 'var fs=require("fs"); var p=require("./package.json"); if (p.dependencies) delete p.dependencies.nodegit; fs.writeFileSync("package.json", JSON.stringify(p, null, 2) + "\n");'; \
    fi \
 && echo "Node: $(node --version)" \
 && echo "npm:  $(npm --version)" \
 && echo "OMIT_NODEGIT=$OMIT_NODEGIT" \
 && npm install --no-audit --no-fund

COPY . .

# Do not start Xronos from this probe image. A successful build only proves the
# selected dependency graph can be installed under Node 24; later checkpoints
# will run tests and the application against the external services.
CMD ["node", "--version"]
