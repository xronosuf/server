extends ../layouts/main

block title
  | Redeem Progress Audit Token

block content
  div.container.mt-5
    .row.p-2
      h1(role="banner") Redeem Progress Audit Token

  div.container.ml-5.p-5
    main
      if error
        div.alert.alert-danger(role="alert")
          strong Error:
          |  #{error}

      p.
        Paste a student's progress audit token and choose an as-of time to view
        the recorded Xronos progress for the Canvas/xourse assignment associated
        with that token.

      form(method="post")
        div.form-group
          label(for="token") Progress audit token
          textarea.form-control#token(name="token", rows="3", required)= token || ''

        fieldset.form-group
          legend As-of time

          div.form-row.align-items-end
            div.form-group.col-md-4
              label(for="asOfDate") Date
              input.form-control#asOfDate(type="date", name="asOfDate", value=asOfDate, required)

            div.form-group.col-md-5
              label Time
              div.d-flex.align-items-center
                input.form-control#asOfHour(type="text", name="asOfHour", value=asOfHour, inputmode="numeric", maxlength="2", pattern="[0-9]*", required, style="max-width: 5rem;")
                span.mx-2 :
                input.form-control#asOfMinute(type="text", name="asOfMinute", value=asOfMinute, inputmode="numeric", maxlength="2", pattern="[0-9]*", required, style="max-width: 5rem;")
                select.form-control.ml-3#asOfAmPm(name="asOfAmPm", style="max-width: 6rem;")
                  option(value="AM", selected=(asOfAmPm == 'AM')) AM
                  option(value="PM", selected=(asOfAmPm == 'PM')) PM

          small.form-text.text-muted.
            Times are interpreted as America/New_York. The default is 11:59 PM,
            which matches the most common Canvas due-time convention.

        button.btn.btn-primary(type="submit")
          i.fa.fa-search
          |  Redeem token

      if report
        hr
        h2 Audit results

        div.alert.alert-info(role="status")
          div
            strong Requested time:
            |  #{report.requested.human}
          div.small
            | UTC: #{report.requested.utc}

        div.row
          div.col-lg-6.mb-4
            div.card.h-100.border-primary
              div.card-header
                h3.h4.mb-0 Recorded progress by selected time
              div.card-body
                if report.asOfMilestone
                  div.mb-3
                    div.d-flex.flex-wrap.align-items-baseline
                      strong.h4.mr-2.mb-1 Observed:
                      span.h4.mb-1 #{report.asOfMilestone.observedAt}
                    div.small.text-muted UTC: #{report.asOfMilestone.observedAtUtc}

                  div.mb-4
                    div.d-flex.flex-wrap.align-items-baseline
                      strong.h4.mr-2.mb-1 Canvas points:
                      span.h4.font-weight-bold.mb-1 #{report.asOfMilestone.canvasPoints}

                  dl.row
                    dt.col-sm-5 Progress
                    dd.col-sm-7 #{report.asOfMilestone.progress}

                    dt.col-sm-5 Xronos points
                    dd.col-sm-7 #{report.asOfMilestone.xronosPoints}

                    dt.col-sm-5 Window started
                    dd.col-sm-7
                      div #{report.asOfMilestone.windowStartedAt}
                      div.small.text-muted UTC: #{report.asOfMilestone.windowStartedAtUtc}

                    dt.col-sm-5 Source
                    dd.col-sm-7 #{report.asOfMilestone.source}

                    dt.col-sm-5 Milestone ID
                    dd.col-sm-7
                      code #{report.asOfMilestone.id}
                else
                  div.alert.alert-warning.mb-0(role="status")
                    strong No recorded progress existed at or before the selected time.

          div.col-lg-6.mb-4
            div.card.h-100.border-secondary
              div.card-header
                h3.h4.mb-0 Current recorded progress reached
              div.card-body
                if report.currentMilestone
                  div.mb-3
                    div.d-flex.flex-wrap.align-items-baseline
                      strong.h4.mr-2.mb-1 Observed:
                      span.h4.mb-1 #{report.currentMilestone.observedAt}
                    div.small.text-muted UTC: #{report.currentMilestone.observedAtUtc}

                  div.mb-4
                    div.d-flex.flex-wrap.align-items-baseline
                      strong.h4.mr-2.mb-1 Canvas points:
                      span.h4.font-weight-bold.mb-1 #{report.currentMilestone.canvasPoints}

                  dl.row
                    dt.col-sm-5 Progress
                    dd.col-sm-7 #{report.currentMilestone.progress}

                    dt.col-sm-5 Xronos points
                    dd.col-sm-7 #{report.currentMilestone.xronosPoints}

                    dt.col-sm-5 Source
                    dd.col-sm-7 #{report.currentMilestone.source}

                    dt.col-sm-5 Milestone ID
                    dd.col-sm-7
                      code #{report.currentMilestone.id}
                else
                  div.alert.alert-secondary.mb-0(role="status")
                    strong No current progress milestone has been recorded for this token.

        div.card.mb-4
          div.card-header Token scope
          div.card-body
            dl.row.mb-0
              dt.col-sm-3 Repository
              dd.col-sm-9 #{report.scope.repository}

              dt.col-sm-3 Assignment path
              dd.col-sm-9 #{report.scope.path}

              dt.col-sm-3 Canvas context
              dd.col-sm-9 #{report.scope.contextId}

              dt.col-sm-3 Canvas resource
              dd.col-sm-9 #{report.scope.resourceLinkId}

              dt.col-sm-3 Created
              dd.col-sm-9 #{report.scope.created}

              dt.col-sm-3 Expires
              dd.col-sm-9 #{report.scope.expires}

        if reportLines
          details.mt-3
            summary Plain-text report
            pre.p-3.bg-light.border.mt-2(style="white-space: pre-wrap;") #{reportLines.join('\n')}
